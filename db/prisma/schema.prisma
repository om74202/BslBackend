// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String @id @default(uuid()) 
  name          String
  email         String @unique
  address       String
  phoneNumber   String
  influxOrgID    String?
  influxToken    String?
  imageUrl      String?     
  shiftCount    Int
  shifts        ShiftTimings[]
  unit          String
  Department    String
  Desingation   String
  checksheets   Checksheet[]
  drives        Drive[]
  users         User[]
  devices       Device[]
  lines         Line[]
}

model ShiftTimings{
  id            String @id @default(uuid())           //shift 
  start           String
  end             String
  plannedBreaks   PlannedBreak[]
  organizationId  String
  lines           Line[]   @relation("LineShift")
  organization    Organization   @relation(fields: [organizationId], references: [id])
}

model CustomShiftsTimings {
  id           String         @id @default(uuid()) 
  start        String
  end          String
  lineId       String
  line         Line @relation(fields: [lineId],references: [lineId])
  plannedBreaksCustom PlannedBreakCustom[]     
}

model PlannedBreakCustom {
  id         String             @id @default(uuid()) 
  start      String
  end        String
  typeOfBreak  String
  customShiftsTimings CustomShiftsTimings @relation(fields: [customShiftTimingId], references: [id])
  customShiftTimingId String   
}

model PlannedBreak{
  id            String @id @default(uuid())
  start        String
  end          String
  typeOfBreak        TypeOfBreak
  ShiftId      String
  shiftTimings        ShiftTimings  @relation(fields: [ShiftId] , references: [id])
}

model Line{
  lineId           String @id @default(uuid()) 
  lineName        String 
  lineType     lineType  @default(mainLine)
  noOfShifts    Int
  noOfCustomShifts  Int
  noOfStations     Int
  customShiftsTimings   CustomShiftsTimings[]
  organizationId    String
  organization      Organization @relation(fields: [organizationId],references: [id])
  users            User[] @relation("UserLine")
  shiftTimings       ShiftTimings[] @relation("LineShift")
  stations     Station[]
  devices      Device[]
  @@unique([lineName,organizationId])
}



model Station{  
  id           String @id @default(uuid())
  name         String  @unique
  Pokayoke     Boolean @default(false)
  lineId       String
  torqueGuns     TorqueGun[]
  line         Line @relation(fields: [lineId],references: [lineId])
}
// Devices 
model TorqueGun{
  torqueGunId          String @id @default(uuid())
  torqueGunName        String
  torqueGunStatus      TorqueGunStatus @default(Active)
  torqueGunMaxLimit     Int
  torqueGunMinLimit     Int
  torqueGunMaxAngle     Int
  torqueGunMinAngle     Int
  createdAt             DateTime @default(now())
  stationId             String
  station               Station @relation(fields: [stationId],references: [id])
  @@unique([torqueGunName, stationId])
}

model Drive{
  driveId          String @id @default(uuid())
  driveName        String 
  organizationId    String
  currentMaxLimit   Int
  currentMinLimit   Int
  voltageMaxLimit   Int 
  voltageMinLimit   Int
  frequencyMaxLimit  Int 
  frequencyMinLimit  Int
  createdAt           DateTime @default(now())
  organization        Organization @relation(fields: [organizationId],references: [id])
  @@unique([driveName,organizationId])
}

model User {
  id            String @id @default(uuid()) 
  name          String 
  email         String @unique
  password      String
  uploadImageUrl      String?
  role          Role  
  status        Status @default(Active)
  createdAt     DateTime @default(now())
  address       String?
  phoneNumber   String?
  lastLogin     DateTime?
  lines          Line[]   @relation("UserLine")
  organizationId  String
  organization   Organization @relation(fields: [organizationId],references: [id])
}



model Device{
  id            String @id @default(uuid())
  name          String
  type          String
  organizationId  String
  lineId         String
  status         DeviceStatus
  organization    Organization @relation(fields: [organizationId],references: [id])
  line            Line @relation( fields: [lineId], references: [lineId])
}



model Checksheet{
  checksheetId        String @id @default(uuid())
  checksheetName      String  
  createdAt           DateTime @default(now())
  updatedAt           DateTime  @updatedAt
  checksheetData      Bytes
  organizationId      String
  checksheetType      ChecksheetType
  organization        Organization @relation(fields: [organizationId],references: [id])

  @@unique([organizationId,checksheetName])
}


enum ChecksheetType{
  Filled
  Template
}




enum DeviceStatus{
  Active
  Inactive
  Maintenance
}
enum Role{
  SuperAdmin
  Admin
  SuperUser
  CheckSheetUser
  User
}

enum lineType{
  mainLine
  subAssemblyLine
}

enum TypeOfBreak{
  Construction
  Maintenance
}

enum Status{
  Active
  Inactive
}

enum TorqueGunStatus{
  Active
  Inactive
}
