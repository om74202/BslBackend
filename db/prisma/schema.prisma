generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String            @id @default(uuid())
  name        String
  email       String            @unique
  address     String
  phoneNumber String
  imageUrl    String?
  unit        String
  Department  String
  Desingation String
  shiftCount  Int
  influxOrgID String?
  influxToken String?
  status      Status            @default(Active)
  tables      ChecksheetTable[]
  devices     Device[]
  drives      Drive[]
  lines       Line[]
  shifts      ShiftTimings[]
  submissions Submission[]
  users       User[]
}

model ShiftTimings {
  id             String         @id @default(uuid())
  start          String
  end            String
  organizationId String
  plannedBreaks  PlannedBreak[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
  lines          Line[]         @relation("LineShift")
}

model CustomShiftsTimings {
  id                  String               @id @default(uuid())
  start               String
  end                 String
  lineId              String
  line                Line                 @relation(fields: [lineId], references: [lineId])
  plannedBreaksCustom PlannedBreakCustom[]
}

model PlannedBreakCustom {
  id                  String              @id @default(uuid())
  start               String
  end                 String
  typeOfBreak         String
  customShiftTimingId String
  customShiftsTimings CustomShiftsTimings @relation(fields: [customShiftTimingId], references: [id])
}

model PlannedBreak {
  id           String       @id @default(uuid())
  start        String
  end          String
  ShiftId      String
  typeOfBreak  String
  lineName     String?
  shiftTimings ShiftTimings @relation(fields: [ShiftId], references: [id],onDelete: Cascade)
}

model Line {
  organizationId      String
  lineId              String                @id @default(uuid())
  lineName            String
  noOfCustomShifts    Int
  noOfShifts          Int
  targetJPH           Int?                      //target Ideal JPH 
  noOfStations        Int
  lineType            lineType              @default(mainLine)
  status              Status                @default(Active)
  customShiftsTimings CustomShiftsTimings[]
  devices             Device[]
  organization        Organization          @relation(fields: [organizationId], references: [id])
  stations            Station[]
  shiftTimings        ShiftTimings[]        @relation("LineShift")
  users               User[]                @relation("UserLine")
  maintenances        Maintenance[]
  downtime            DowntimeManagement[]
  downTimeReports     DowntimeReport[]
  plannedShutdowns    PlannedShutdown[]  @relation("LinePlannedShutdowns")
  targetJPHUpdateHistory   TargetJPHUpdateHistory[]
  shiftLogBooks ShiftLogBook[]
  @@unique([lineName, organizationId])
}

model TargetJPHUpdateHistory {
  id            String @id @default(uuid())
  userId        String
  user          User @relation(fields: [userId],references: [id])
  updatedAt     DateTime @default(now())
  lineId        String
  updatedValue  Int?
  line          Line @relation(fields: [lineId],references: [lineId])
}

model Station {
  id         String      @id @default(uuid())
  name       String      @unique
  lineId     String
  Pokayoke   Boolean     @default(false)
  status     Status      @default(Active)
  line       Line        @relation(fields: [lineId], references: [lineId])
  torqueGuns TorqueGun[]
}

model TorqueGun {
  torqueGunId       String          @id @default(uuid())
  torqueGunName     String
  torqueGunStatus   TorqueGunStatus @default(Active)
  torqueGunIp       String?
  torqueGunMaxLimit Int
  torqueGunMinLimit Int
  torqueGunMaxAngle Int
  torqueGunMinAngle Int
  createdAt         DateTime        @default(now())
  stationId         String
  status            Status          @default(Active)
  station           Station         @relation(fields: [stationId], references: [id])

  @@unique([torqueGunName, stationId])
}

model Drive {
  driveId           String       @id @default(uuid())
  driveName         String
  organizationId    String
  currentMaxLimit   Int
  currentMinLimit   Int
  voltageMaxLimit   Int
  voltageMinLimit   Int
  frequencyMaxLimit Int
  frequencyMinLimit Int
  createdAt         DateTime     @default(now())
  status            Status       @default(Active)
  organization      Organization @relation(fields: [organizationId], references: [id])

  @@unique([driveName, organizationId])
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  role             Role
  status           Status            @default(Active)
  createdAt        DateTime          @default(now())
  address          String?
  phoneNumber      String?
  lastLogin        DateTime?
  organizationId   String
  uploadImageUrl   String?
  targetJPHUpdateHistory  TargetJPHUpdateHistory[]
  plannedShutdownUpdateHistory    PlannedShutdownUpdateHistory[]
  plannedShutdowns PlannedShutdown[]
  downTimeReports  DowntimeReport[]
  checksheetTables ChecksheetTable[]
  submissions      Submission[]
  organization     Organization      @relation(fields: [organizationId], references: [id])
  lines            Line[]            @relation("UserLine")
}

model Device {
  id             String       @id @default(uuid())
  name           String
  type           String
  
  organizationId String
  lineId         String
  status         DeviceStatus
  line           Line         @relation(fields: [lineId], references: [lineId])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model ChecksheetTable {
  id             String        @id @default(uuid())
  name           String
  tableData      Json
  cellProperties Json
  cellStyles     Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?
  userId         String
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
}

model IdealParameters{
  id              String  @id @default(uuid())
  JPH             String  @default("50")
  Quality         String  @default("99")
  createdAt       DateTime @default(now())
  lineName        String
}

model DowntimeManagement{
  id              String @id @default(uuid())
  type            DowntimeType 
  reason          String
  reasonType      String
  startTime       DateTime
  endTime         DateTime
  lineId          String
  line            Line @relation(fields: [lineId],references: [lineId])
}

model ProductionLossReasons{
  id             String @id @default(uuid())
  lossCode       String 
  lossReason     String
  lossSubReason        String[]
}

//holiday section

model PlannedShutdown{
  id             String @id @default(uuid())
  name           String 
  type           shutdownType 
  startTime      DateTime?
  endTime        DateTime?
  createdBy      String?
  reason         String?
  createdAt      DateTime @default(now())
  description    String?
  updateHistory  PlannedShutdownUpdateHistory[]
   downtimeReportId String?
  downtimeReport   DowntimeReport? @relation("DowntimeReportToPlannedShutdown", fields: [downtimeReportId], references: [id])

  lines           Line[]      @relation("LinePlannedShutdowns")
  user           User?    @relation(fields: [createdBy],references: [id])
}

model PlannedShutdownUpdateHistory{
  id            String @id @default(uuid())
  userId        String
  user          User @relation(fields: [userId],references: [id])
  updatedAt     DateTime @default(now())
  plannedShutdownId    String
  updatedValue   Json
  plannedShutdown     PlannedShutdown @relation(fields: [plannedShutdownId],references:[id])
}

enum shutdownType {
  Holiday
  PlannedShutdown
  UnplannedDowntime
}

model DowntimeReport {
  id            String   @id @default(uuid())
  lineId        String
  line          Line     @relation(fields: [lineId], references: [lineId])

  shift         String
  reportDate    DateTime
  isSubmitted   Boolean @default(false)     
  createdAt     DateTime @default(now())
  plannedShutdowns       PlannedShutdown[]  @relation("DowntimeReportToPlannedShutdown")
  
  createdBy     String?
  user          User?    @relation(fields: [createdBy], references: [id])
  rows          Json     // ✅ store rows here
  @@unique([lineId, reportDate, shift])
}


model tracking_events {
  id           BigInt   @id @default(autoincrement())
  ts           DateTime @default(now()) @db.Timestamptz(6)
  user_id      String
  event_name   String
  route        String?
  page_name    String?
  element_id   String?
  element_text String?
  metadata     Json?
  ip           String?
  user_agent   String?
}


model ShiftLogBook {
  id               String   @id @default(uuid())

  lineId           String
  reportDate       String
  shift            String

  // Store the whole sheet as JSON (easiest + matches your UI shape)
  payload          Json
  line             Line     @relation(fields: [lineId],references: [lineId])
  isSubmitted      Boolean  @default(false)
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([lineId, reportDate, shift])
  @@index([lineId, reportDate, shift])
}











model Maintenance{
  id      String @id @default(uuid())
  message    String
  status     maintenanceStatus @default(open)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime @updatedAt
  approvedBy   String?
  reviewComment  String?
  startTime    DateTime?
  endTime      DateTime?
  createdBy     String?
  lineId       String
  line         Line @relation(fields: [lineId],references: [lineId])
}

model Submission {
  id             String           @id @default(uuid())
  userId         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cellProperties Json
  cellStyles     Json
  name           String
  organizationId String
  tableData      Json
  status         SubmissionStatus @default(Pending)
  comment        String?
  line           String?
  ApprovedBy     String?
  location       String?
  shift          String?
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
}

model Truck {
  id            String   @id @default(cuid())
  name          String   @unique  
  alias         String?
  status        TruckStatus  @default(Stopped)
  data          Json
  trips         Trip[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Trip {
  id            String   @id @default(uuid())
  departBsl     DateTime? 
  reachedMsil       DateTime?
  departMsil      DateTime?
  reachedBsl     DateTime?
  truckId       String
  createdAt   DateTime @default(now()) 
  updatedAt   DateTime @updatedAt    
  truck         Truck     @relation(fields: [truckId],references: [id])
}

enum TruckStatus{
  toMSIL
  toBSL
  atBSL
  Stopped
  atMSIL
}



enum DowntimeType {
  Planned
  Unplanned
}

enum SubmissionStatus {
  Pending
  Approved
  Rejected
}

enum maintenanceStatus {
  open
  close
}

enum DeviceStatus {
  Active
  Inactive
  Maintenance
}

enum Role {
  SuperAdmin
  Admin
  SuperUser
  CheckSheetUser
  User
  Maruti_Bsl
  CEO
}

enum lineType {
  mainLine
  subAssemblyLine
}

enum TypeOfBreak {
  Construction
  Maintenance
}

enum Status {
  Active
  Inactive
}

enum TorqueGunStatus {
  Active
  Inactive
}

enum ProductionParamType {
  JPH
  Quality
}

